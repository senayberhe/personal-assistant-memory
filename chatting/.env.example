# Copy this file to .env (same folder) and fill in your key.
# .env is ignored by git, so your key is never committed.

# Required: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_api_key_here

# Model used for chatting and for memory decisions.
ASSISTANT_MODEL=gpt-5.6-luna
# Model used to embed memories for semantic search.
EMBEDDING_MODEL=text-embedding-3-small

# development | testing | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Seconds before an OpenAI request / a tool call is abandoned.
API_TIMEOUT=30
TOOL_TIMEOUT=10

# Maximum model/tool round trips per message.
MAX_AGENT_STEPS=10
MAX_PLAN_STEPS=10

# Voice mode: seconds to wait for speech, max phrase length,
# and seconds spent calibrating for background noise.
SPEECH_TIMEOUT=5
PHRASE_TIME_LIMIT=8
AMBIENT_NOISE_DURATION=1

# Where memories are stored. Relative paths are relative to chatting/.
MEMORY_DIRECTORY=data/memory

# Ask before saving facts picked up from conversation (true/false).
# Keep this on unless you review your memories regularly.
MEMORY_REQUIRE_APPROVAL=true
